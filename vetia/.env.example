# VETIA — variables de entorno (COPIAR a vetia/.env EN EL VPS; .env está git-ignorado).
# Lucas lo completa a mano en el servidor. NADA de esto va al repo ni al cliente.

# --- Clave de Anthropic (obligatoria para que responda el modelo) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo (default claude-haiku-4-5). No cambiar salvo decisión.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Firebase (verificación del ID token del titular) ---
# Ruta ABSOLUTA al service account JSON del proyecto DEMO (medipaw-demo). Fuera del repo.
FIREBASE_SA_PATH=/ruta/absoluta/al/serviceAccount.medipaw-demo.json
FIREBASE_PROJECT_ID=medipaw-demo

# --- Red / CORS ---
# Puerto local donde escucha VETIA (nginx hace proxy_pass a este). Propuesto: 3003 (libre en el VPS).
PORT=3003
# Único origen autorizado (el front del demo). En prod, cuando el socio viva en medipaw.com.ar, es same-origin
# (no hace falta CORS); si se sirve cross-origin, cambiar por https://medipaw.com.ar.
ALLOW_ORIGIN=https://medipaw-demo.web.app

# --- Ajustes opcionales (tienen default en el código) ---
# TEL_EMERG: teléfono de guardia real de MEDIPaw (hoy placeholder). Se muestra en la respuesta de urgencia.
TEL_EMERG=0800-URGENCIA
# MAX_TOKENS=512
# TIMEOUT_MS=18000
# MAX_MSG_CHARS=2000
