{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/predeploy-guard.js"
    ]
  },
  "hosting": {
    "public": "hosting-demo",
    "predeploy": [
      "node scripts/predeploy-guard.js",
      "node scripts/build-hosting-demo.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/sw.js",         "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html",        "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/",       "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/socio",  "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/app",    "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/landing","headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/brand",  "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
