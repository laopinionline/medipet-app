rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: obtener roles del usuario ──
    function getUserRoles() {
      let userData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return userData.roles;
    }

    function isAdmin() {
      return request.auth != null && 'admin' in getUserRoles();
    }

    // Transitorio: acepta 'veterinario' O 'prestador' (legacy) en roles[].
    // Limpiar después de que todos los docs estén migrados.
    function esVeterinario() {
      let roles = getUserRoles();
      return request.auth != null
        && ('veterinario' in roles || 'prestador' in roles);
    }

    // ══════════════════════════════════════
    // ══  USUARIOS                        ══
    // ══════════════════════════════════════
    match /usuarios/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  MASCOTAS (colección propia, F0.5) ══
    // ══════════════════════════════════════
    // La MASCOTA es el sujeto: tiene su plan, su cuota y su ESTADO (cobertura por mascota).
    // Read: admin, cualquier veterinario (reemplaza la credencial de papel), o el TITULAR dueño.
    // Write sensible (plan/estado/cuota/titularUid/mascotaId/token) = SOLO admin.
    // El titular puede: crear una mascota SUYA que nace 'suspendido' + cuota 0 (sin cobertura hasta
    // que admin la active) y editar SOLO campos descriptivos no sensibles. Nunca se auto-otorga cobertura.
    match /mascotas/{mascotaId} {
      allow get: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);
      allow list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);

      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.titularUid == request.auth.uid
            && request.resource.data.estado == 'suspendido'
            && request.resource.data.cuota == 0);

      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.titularUid == request.auth.uid
            && request.resource.data.titularUid == resource.data.titularUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'raza', 'fechaNacimiento', 'foto']));

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  CASOS (F1-B · despacho veterinario) ══
    // ══════════════════════════════════════
    // SPLIT para la asimetría N3 (inviolable): lo que ve el titular vive en `casos`; lo clínico interno
    // (prioridad, notas del vet, clasificación) vive en `casos_clinico` y el titular NUNCA lo lee.
    // `casos` = cara al titular: relato, estado, respuestaTitular (cuidado y acción), atencionId.
    match /casos/{casoId} {
      // Crea el TITULAR dueño de la mascota (verifica que la mascota exista y sea suya). Nace 'nuevo'.
      allow create: if request.auth != null
        && request.resource.data.titularUid == request.auth.uid
        && request.resource.data.estado == 'nuevo'
        && exists(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId))
        && get(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId)).data.titularUid == request.auth.uid;
      // Lee: vet, admin, o el titular dueño (solo campos titular-safe viven acá).
      allow get, list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);
      // Gestiona (estado, respuestaTitular, atencionId): SOLO vet/admin. El titular no edita su caso.
      allow update: if request.auth != null && (isAdmin() || esVeterinario());
      allow delete: if isAdmin();
    }

    // `casos_clinico` = lo INTERNO del vet (prioridad, notas, clasificación). El titular NUNCA accede (N3).
    match /casos_clinico/{casoId} {
      allow read, write: if request.auth != null && (isAdmin() || esVeterinario());
    }

    // ══════════════════════════════════════
    // ══  COMPROBANTES (F1-C · contable)  ══
    // ══════════════════════════════════════
    // Comprobantes INTERNOS no-fiscales. SNAPSHOT (items/total congelados al emitir). Los emite/gestiona el admin;
    // el titular SOLO lee los suyos (no puede pagar en la app — sin pasarela todavía).
    match /comprobantes/{id} {
      allow get, list: if request.auth != null && (isAdmin() || resource.data.titularUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    // Contador correlativo de comprobantes (numeración atómica por transacción). Solo admin.
    match /contadores/{id} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  MASCOTAS PUBLICAS               ══
    // ══════════════════════════════════════
    match /mascotas_publicas/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // ══════════════════════════════════════
    // ══  SOLICITUDES                     ══
    // ══════════════════════════════════════
    match /solicitudes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ══════════════════════════════════════
    // ══  ATENCIONES                      ══
    // ══════════════════════════════════════
    //
    // Create: solo veterinarios, y prestadorId debe ser el uid del vet.
    // Read: veterinario, admin, o dueño de la mascota (titularUid).
    // Update: admin o el vet que la creó.
    // Delete: solo admin.
    //
    match /atenciones/{id} {
      allow create: if request.auth != null
        && esVeterinario()
        && request.resource.data.prestadorId == request.auth.uid;

      allow get: if request.auth != null
        && (isAdmin()
            || esVeterinario()
            || resource.data.titularUid == request.auth.uid);

      allow list: if request.auth != null
        && (isAdmin()
            || esVeterinario()
            || resource.data.titularUid == request.auth.uid);

      allow update: if request.auth != null
        && (isAdmin()
            || resource.data.prestadorId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  PRESTADORES (proveedores ext.)  ══
    // ══════════════════════════════════════
    // Colección separada de usuarios. Proveedores externos con
    // relación económica. Solo admin gestiona.
    match /prestadores/{id} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  CATCH-ALL: DENEGAR              ══
    // ══════════════════════════════════════
    // Cualquier colección no listada arriba queda bloqueada.
  }
}
