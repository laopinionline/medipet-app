rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: obtener roles del usuario (ROBUSTO) ──
    // Guarda con exists() para no hacer get() sobre un doc inexistente, y default [] si falta el campo roles.
    // Evita el error de evaluación null.roles (que denegaba a titulares legítimos y complicaba el orden de ramas).
    function getUserRoles() {
      return (request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('roles', [])
        : [];
    }

    function isAdmin() {
      return request.auth != null && 'admin' in getUserRoles();
    }

    // Transitorio: acepta 'veterinario' O 'prestador' (legacy) en roles[].
    // Limpiar después de que todos los docs estén migrados.
    function esVeterinario() {
      let roles = getUserRoles();
      return request.auth != null
        && ('veterinario' in roles || 'prestador' in roles);
    }

    // ── Alta como embudo: el SISTEMA fija plan y cuota por especie + EDAD APROXIMADA (bucket; réplica de
    //    lib/medipaw-core.planPorEdadAprox). El titular NO puede mandar plan/cuota arbitrarios. La fecha exacta
    //    es opcional y NO decide el plan (solo refina el recálculo). Sin math de request.time → sin bordes. ──
    function planEsperadoR(data) {
      return (data.especie == 'perro' || data.especie == 'gato')
        ? (data.edadAprox == 'cachorro' ? 'MEDIPaw Joven'
           : (data.edadAprox == 'mayor' ? 'MEDIPaw Senior' : 'MEDIPaw Adulto'))
        : 'MEDIPaw Básico';
    }
    function precioDeR(plan) {
      return plan == 'MEDIPaw Urgencias' ? 23988
        : plan == 'MEDIPaw Básico' ? 40000
        : plan == 'MEDIPaw Joven' ? 58788
        : plan == 'MEDIPaw Adulto' ? 54388
        : plan == 'MEDIPaw Senior' ? 70788
        : -1;
    }

    // ══════════════════════════════════════
    // ══  USUARIOS                        ══
    // ══════════════════════════════════════
    match /usuarios/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // (a) FIX escalada de privilegios: el DUEÑO solo puede tocar campos NO privilegiados (whitelist). `roles`/`rol`/
      //     `estado` quedan FUERA de su alcance → un titular no puede agregarse 'admin'/'veterinario'. Grants = solo
      //     admin o seed/agregar-rol.js. `mascotas` está en el whitelist porque el embudo espeja ahí (no da cobertura).
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['mascotas', 'fotoTitular', 'nombre', 'apellido', 'telefono']));
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  MASCOTAS (colección propia, F0.5) ══
    // ══════════════════════════════════════
    // La MASCOTA es el sujeto: tiene su plan, su cuota y su ESTADO (cobertura por mascota).
    // Read: admin, cualquier veterinario (reemplaza la credencial de papel), o el TITULAR dueño.
    // ALTA COMO EMBUDO (este tramo): el titular crea su mascota ACTIVA, pero el plan y la cuota los VALIDA la
    // regla por especie/edad (planEsperadoR/precioDeR). No puede elegir plan ni cuota ni mandar valores arbitrarios.
    match /mascotas/{mascotaId} {
      allow get: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);
      allow list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);

      // (b) FIX orden de evaluación: rama TITULAR primero (no llama isAdmin() para un titular). Con getUserRoles
      //     robusto, isAdmin() ya no puede errorear igual; el orden es defensa extra + claridad.
      allow create: if (request.auth != null
            && request.resource.data.titularUid == request.auth.uid
            && request.resource.data.estado == 'activo'
            && (request.resource.data.especie in ['perro', 'gato', 'ave', 'otros'])
            && (request.resource.data.edadAprox in ['cachorro', 'joven', 'adulto', 'mayor'])
            && request.resource.data.plan == planEsperadoR(request.resource.data)
            && request.resource.data.cuota == precioDeR(request.resource.data.plan))
        || isAdmin();

      // El titular edita SOLO cosméticos (nombre/foto). NO toca fechaNacimiento (afecta el plan), ni plan/estado/cuota.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.titularUid == request.auth.uid
            && request.resource.data.titularUid == resource.data.titularUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'foto']));

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  PESOS (serie de peso por mascota) ══
    // ══════════════════════════════════════
    // Serie append-only: el peso NO es un campo que se pisa; cada medición es un punto {mascotaId, peso, fecha}.
    // El primer punto se crea en el alta; el bloque "Chequeo y peso" agrega más. El titular agrega a SU mascota y
    // lee lo suyo; vet/admin leen. Inmutable para el titular (no edita ni borra puntos).
    match /pesos/{id} {
      // (f) FIX: el vet/admin también cargan peso (guardia). La mascota debe existir; el titular solo la suya.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId))
        && (isAdmin() || esVeterinario()
            || (request.resource.data.titularUid == request.auth.uid
                && get(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId)).data.titularUid == request.auth.uid));
      allow get, list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  CASOS (F1-B · despacho veterinario) ══
    // ══════════════════════════════════════
    // SPLIT para la asimetría N3 (inviolable): lo que ve el titular vive en `casos`; lo clínico interno
    // (prioridad, notas del vet, clasificación) vive en `casos_clinico` y el titular NUNCA lo lee.
    // `casos` = cara al titular: relato, estado, respuestaTitular (cuidado y acción), atencionId.
    match /casos/{casoId} {
      // Crea el TITULAR dueño de la mascota (verifica que la mascota exista y sea suya). Nace 'nuevo'.
      allow create: if request.auth != null
        && request.resource.data.titularUid == request.auth.uid
        && request.resource.data.estado == 'nuevo'
        && exists(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId))
        && get(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId)).data.titularUid == request.auth.uid;
      // Lee: vet, admin, o el titular dueño (solo campos titular-safe viven acá).
      allow get, list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);
      // Gestiona (estado, respuestaTitular, atencionId): SOLO vet/admin. El titular no edita su caso.
      allow update: if request.auth != null && (isAdmin() || esVeterinario());
      allow delete: if isAdmin();
    }

    // `casos_clinico` = lo INTERNO del vet (prioridad, notas, clasificación). El titular NUNCA accede (N3).
    match /casos_clinico/{casoId} {
      allow read, write: if request.auth != null && (isAdmin() || esVeterinario());
    }

    // ══════════════════════════════════════
    // ══  COMPROBANTES (F1-C · contable)  ══
    // ══════════════════════════════════════
    // Comprobantes INTERNOS no-fiscales. SNAPSHOT (items/total congelados al emitir). Los emite/gestiona el admin;
    // el titular SOLO lee los suyos (no puede pagar en la app — sin pasarela todavía).
    match /comprobantes/{id} {
      allow get, list: if request.auth != null && (isAdmin() || resource.data.titularUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    // Contador correlativo de comprobantes (numeración atómica por transacción). Solo admin.
    match /contadores/{id} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  MASCOTAS PUBLICAS               ══
    // ══════════════════════════════════════
    match /mascotas_publicas/{token} {
      allow get: if true;
      allow list: if false;
      // (c) FIX: solo admin escribe (antes cualquier autenticado podía pisar la ficha pública de cualquier mascota).
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  SOLICITUDES                     ══
    // ══════════════════════════════════════
    match /solicitudes/{id} {
      allow create: if true;
      // (d) FIX: solo admin lee/gestiona (contiene bajas, cambios de plan y leads con datos de contacto).
      allow read, update, delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  ATENCIONES                      ══
    // ══════════════════════════════════════
    //
    // Create: solo veterinarios, y prestadorId debe ser el uid del vet.
    // Read: veterinario, admin, o dueño de la mascota (titularUid).
    // Update: admin o el vet que la creó.
    // Delete: solo admin.
    //
    match /atenciones/{id} {
      // (e) FIX: exigir titularUid en el create (si no, el titular nunca puede leer su propia atención — el read lo pide).
      allow create: if request.auth != null
        && esVeterinario()
        && request.resource.data.prestadorId == request.auth.uid
        && request.resource.data.titularUid is string
        && request.resource.data.titularUid.size() > 0;

      allow get: if request.auth != null
        && (isAdmin()
            || esVeterinario()
            || resource.data.titularUid == request.auth.uid);

      allow list: if request.auth != null
        && (isAdmin()
            || esVeterinario()
            || resource.data.titularUid == request.auth.uid);

      allow update: if request.auth != null
        && (isAdmin()
            || resource.data.prestadorId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  PRESTADORES (proveedores ext.)  ══
    // ══════════════════════════════════════
    // Colección separada de usuarios. Proveedores externos con
    // relación económica. Solo admin gestiona.
    match /prestadores/{id} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  CARTILLA (directorio informativo) ══
    // ══════════════════════════════════════
    // Directorio de prestadores para el socio. NO vinculado a mascotas/atenciones (informativo puro).
    // Lectura: cualquier autenticado (el filtro estado=='visible' lo hace la QUERY del socio; el admin ve todo).
    // Escritura (alta/edición/ocultar/baja): SOLO admin. `estado` no se filtra en la regla (es un directorio público
    // dentro de la app, sin datos sensibles: nombre/especialidad/dirección/teléfono/horarios de prestadores).
    match /cartilla/{id} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ══════════════════════════════════════
    // ══  TURNOS (agenda del vet de guardia) ══
    // ══════════════════════════════════════
    // Agenda ÚNICA (un solo vet de guardia MEDIPaw): las FRANJAS (`agenda_turnos`) las mantiene admin/vet; el socio
    // JAMÁS escribe `slotsTomados`. La RESERVA y su liberación van SOLO por el endpoint del VPS (Admin SDK): la
    // atomicidad del slot (evitar doble-booking) NO es expresable en reglas puras — por eso `turnos` create = false
    // para el cliente. Acople al motor de coberturas = INFORMATIVO (el endpoint devuelve el cupo de 'consulta'); el
    // consumo real lo registra la ATENCIÓN del vet, no el turno.
    match /agenda_turnos/{id} {
      allow get, list: if request.auth != null;                 // el socio ve la disponibilidad
      allow create, update: if isAdmin() || esVeterinario();    // baja lógica (activa:false); nunca delete
      allow delete: if false;
    }

    match /turnos/{id} {
      // Create SOLO por el endpoint (Admin SDK bypassa reglas). El cliente no crea → sin doble-booking por reglas.
      allow create: if false;

      allow get, list: if request.auth != null
        && (isAdmin() || esVeterinario() || resource.data.titularUid == request.auth.uid);

      // Update:
      //  · vet/admin MARCA asistencia — acotado a campos de marca; estado dentro de la máquina.
      //  · el TITULAR dueño CANCELA su turno — acotado a estado:'cancelado' (+ canceladoEn). El endpoint es la vía que
      //    además LIBERA el slot; una cancelación directa por cliente deja el slot marcado (se reconcilia por el vet).
      allow update: if request.auth != null
        && (
          ( (isAdmin() || esVeterinario())
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'estadoMarcadoPor', 'estadoMarcadoEn', 'canceladoEn'])
            && request.resource.data.estado in ['creado', 'atendido', 'ausente', 'sin_registrar', 'cancelado'] )
          ||
          ( resource.data.titularUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEn'])
            && request.resource.data.estado == 'cancelado' )
        );

      allow delete: if false;
    }

    // ══════════════════════════════════════
    // ══  CATCH-ALL: DENEGAR              ══
    // ══════════════════════════════════════
    // Cualquier colección no listada arriba queda bloqueada.
  }
}
